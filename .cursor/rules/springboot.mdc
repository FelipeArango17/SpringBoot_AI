```
SpringBoot_AI/
├── .cursor/rules/springboot.mdc
├── backend/                      # Spring Boot 4, Maven, Java 21
│   ├── .env / .env.example       # DB_URL, DB_USERNAME, DB_PASSWORD
│   ├── pom.xml
│   └── src/main/java/co/edu/tdea/reservation/
│       ├── ReservationApplication.java
│       ├── config/CorsConfig.java
│       ├── controller/ReservationController.java
│       ├── dto/{ReservationRequest, ReservationResponse, ErrorResponse}.java
│       ├── entity/{Reservation, ReservationStatus}.java
│       ├── exception/{BusinessException, InvalidReservationException, ReservationNotFoundException, GlobalExceptionHandler}.java
│       ├── repository/ReservationRepository.java
│       └── service/ReservationService.java
└── frontend/                     # React 19 + TypeScript + Vite
    ├── .env / .env.example       # VITE_API_URL
    └── src/
        ├── App.tsx / App.css
        ├── components/{ReservationForm, ReservationTable, Toast}.tsx + .css
        ├── services/ReservationService.ts
        └── types/reservation.ts
```
